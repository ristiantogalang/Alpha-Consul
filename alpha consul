            </div>
            
            <div class="border-t border-navy-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-xs text-slate-500">
                    © 2026 Alpha Finance Consulting. All Rights Reserved.
                </p>
                <div class="flex gap-4">
                    <a href="https://wa.me/6285877141542" target="_blank" class="text-slate-500 hover:text-white transition"><i class="fa-brands fa-whatsapp text-lg"></i></a>
