    <!-- Floating WhatsApp Button -->
    <a href="https://wa.me/6285877141542?text=Halo%20Alpha%20Finance%20Consulting,%20saya%20ingin%20berkonsultasi%20mengenai%20layanan%20akuntansi." target="_blank" class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white w-14 h-14 rounded-full flex items-center justify-center text-3xl shadow-[0_4px_14px_rgba(37,211,102,0.4)] hover:bg-[#20bd5a] transition transform hover:scale-110" aria-label="WhatsApp">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <script>
        function showCustomModal(title, message, isSuccess = true) {
            const modal = document.getElementById('custom-modal');
            const modalTitle = document.getElementById('modal-title');
            const modalMessage = document.getElementById('modal-message');
            const iconContainer = document.getElementById('modal-icon-container');

            modalTitle.textContent = title;
            modalMessage.textContent = message;

            if (isSuccess) {
                iconContainer.className = 'w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl mx-auto mb-4';
                iconContainer.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
            } else {
                iconContainer.className = 'w-16 h-16 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-3xl mx-auto mb-4';
                iconContainer.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
            }

            modal.classList.remove('hidden');
        }

        function closeCustomModal() {
            const modal = document.getElementById('custom-modal');
            modal.classList.add('hidden');
        }

        // Mobile Menu Toggle
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
            
            const icon = btn.querySelector('i');
            if (menu.classList.contains('hidden')) {
                icon.classList.remove('fa-xmark');
                icon.classList.add('fa-bars');
            } else {
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-xmark');
            }
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                menu.classList.add('hidden');
                menu.classList.remove('flex');
                btn.querySelector('i').classList.remove('fa-xmark');
                btn.querySelector('i').classList.add('fa-bars');
            });
        });

        // Navbar scroll effect & Scroll Progress
        const navbar = document.getElementById('navbar');
        const scrollProgress = document.getElementById('scroll-progress');

        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrollPercent = (scrollTop / docHeight) * 100;
            scrollProgress.style.width = scrollPercent + '%';

            if (scrollTop > 20) {
                navbar.classList.add('shadow-md');
                navbar.classList.replace('py-4', 'py-3');
            } else {
                navbar.classList.remove('shadow-md');
                navbar.classList.replace('py-3', 'py-4');
            }

            const parallaxBg = document.getElementById('parallax-bg-1');
            if (parallaxBg && scrollTop < 600) {
                parallaxBg.style.transform = `translate(-50%, calc(-50% + ${scrollTop * 0.15}px))`;
            }
        });

        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.12
        };

        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('revealed');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.addEventListener('DOMContentLoaded', () => {
            const revealElements = document.querySelectorAll('.reveal-init');
            revealElements.forEach(el => revealObserver.observe(el));

            const homeNav = document.querySelector('.nav-item[data-target="home"]');
            if (homeNav && !homeNav.querySelector('.active-indicator')) {
                homeNav.classList.add('text-corporate-yellow', 'font-semibold');
                const line = document.createElement('div');
                line.className = 'active-indicator absolute -bottom-1.5 left-0 w-full h-[2px] bg-corporate-yellow';
                homeNav.appendChild(line);
            }

            // Make pricing plan / service buttons pre-fill service dropdown or scroll to contact
            const serviceCtas = document.querySelectorAll('#layanan a, #paket a');
            serviceCtas.forEach(cta => {
                cta.addEventListener('click', function(e) {
                    const card = this.closest('div');
                    if (card) {
                        const titleEl = card.querySelector('h3');
                        if (titleEl) {
                            const serviceName = titleEl.textContent.trim();
                            const selectEl = document.getElementById('form-kebutuhan');
                            if (selectEl) {
                                for (let i = 0; i < selectEl.options.length; i++) {
                                    if (selectEl.options[i].text.toLowerCase().includes(serviceName.toLowerCase()) || 
                                        serviceName.toLowerCase().includes(selectEl.options[i].value.toLowerCase())) {
                                        selectEl.selectedIndex = i;
                                        break;
                                    }
                                }
                            }
                        }
                    }
                });
            });
        });

        const navItems = document.querySelectorAll('.nav-item');
        const sections = document.querySelectorAll('section[id]');

        navItems.forEach(item => {
            item.addEventListener('click', function() {
                navItems.forEach(nav => {
                    nav.classList.remove('text-corporate-yellow', 'font-semibold');
                    nav.classList.add('text-slate-300', 'font-medium');
                    const existingLine = nav.querySelector('.active-indicator');
                    if (existingLine) existingLine.remove();
                });

                this.classList.remove('text-slate-300', 'font-medium');
                this.classList.add('text-corporate-yellow', 'font-semibold');
                
                if (!this.querySelector('.active-indicator')) {
                    const line = document.createElement('div');
                    line.className = 'active-indicator absolute -bottom-1.5 left-0 w-full h-[2px] bg-corporate-yellow';
                    this.appendChild(line);
                }
            });
        });

        window.addEventListener('scroll', () => {
            let scrollY = window.pageYOffset;
            sections.forEach(section => {
                const sectionHeight = section.offsetHeight;
                const sectionTop = section.offsetTop - 120;
                const sectionId = section.getAttribute('id');
                
                if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
                    navItems.forEach(item => {
                        if (item.getAttribute('data-target') === sectionId) {
                            item.classList.remove('text-slate-300', 'font-medium');
                            item.classList.add('text-corporate-yellow', 'font-semibold');
                            if (!item.querySelector('.active-indicator')) {
                                navItems.forEach(other => {
                                    other.classList.remove('text-corporate-yellow', 'font-semibold');
                                    other.classList.add('text-slate-300', 'font-medium');
                                    const ind = other.querySelector('.active-indicator');
                                    if (ind) ind.remove();
                                });
                                item.classList.add('text-corporate-yellow', 'font-semibold');
                                const line = document.createElement('div');
                                line.className = 'active-indicator absolute -bottom-1.5 left-0 w-full h-[2px] bg-corporate-yellow';
                                item.appendChild(line);
                            }
                        }
                    });
                }
            });
        });

        function submitForm(e) {
            e.preventDefault();
            
            const namaEl = document.getElementById('form-nama');
            const whatsappEl = document.getElementById('form-whatsapp');
            const emailEl = document.getElementById('form-email');
            const usahaEl = document.getElementById('form-usaha');
            const kebutuhanEl = document.getElementById('form-kebutuhan');
            const pesanEl = document.getElementById('form-pesan');

            const errorNama = document.getElementById('error-nama');
            const errorWhatsapp = document.getElementById('error-whatsapp');
            const errorEmail = document.getElementById('error-email');
            const errorUsaha = document.getElementById('error-usaha');
            const errorKebutuhan = document.getElementById('error-kebutuhan');

            [errorNama, errorWhatsapp, errorEmail, errorUsaha, errorKebutuhan].forEach(el => el.classList.add('hidden'));
            [namaEl, whatsappEl, emailEl, usahaEl, kebutuhanEl].forEach(el => el.classList.remove('border-rose-500'));

            let isValid = true;

            const nama = namaEl.value.trim();
            if (!nama) {
                errorNama.classList.remove('hidden');
                namaEl.classList.add('border-rose-500');
                isValid = false;
            }

            const whatsapp = whatsappEl.value.trim();
            const phoneRegex = /^[0-9+\-\s]{10,15}$/;
            if (!whatsapp || !phoneRegex.test(whatsapp)) {
                errorWhatsapp.classList.remove('hidden');
                whatsappEl.classList.add('border-rose-500');
                isValid = false;
            }

            const email = emailEl.value.trim();
            if (email) {
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email)) {
                    errorEmail.classList.remove('hidden');
                    emailEl.classList.add('border-rose-500');
                    isValid = false;
                }
            }

            const usaha = usahaEl.value.trim();
            if (!usaha) {
                errorUsaha.classList.remove('hidden');
                usahaEl.classList.add('border-rose-500');
                isValid = false;
            }

            const kebutuhan = kebutuhanEl.value;
            if (!kebutuhan) {
                errorKebutuhan.classList.remove('hidden');
                kebutuhanEl.classList.add('border-rose-500');
                isValid = false;
            }

            if (!isValid) {
                const firstError = document.querySelector('.border-rose-500');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstError.focus();
                }
                showCustomModal('Perhatian', 'Mohon lengkapi semua kolom wajib dengan data yang valid sebelum melanjutkan.', false);
                return;
            }

            const pesan = pesanEl.value.trim() || '-';
            const successAlert = document.getElementById('form-success');
            const btn = document.querySelector('#contactForm button[type="submit"]');
            
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Menyiapkan WhatsApp...';
            btn.disabled = true;
            btn.classList.add('opacity-70');

            // Format message concisely to avoid URL truncation or limits
            const rawText = `Halo Alpha Finance Consulting, saya ingin berkonsultasi.\n\n` +
                          `• Nama: ${nama}\n` +
                          `• No WA: ${whatsapp}\n` +
                          `• Email: ${email || '-'}\n` +
                          `• Usaha: ${usaha}\n` +
                          `• Layanan: ${kebutuhan}\n` +
                          `• Pesan: ${pesan}`;

            const targetWhatsAppNumber = '6285877141542';
            
            // Safe URL encoding with fallback length safety check
            const encodedText = encodeURIComponent(rawText);
            const whatsappURL = `https://wa.me/${targetWhatsAppNumber}?text=${encodedText}`;

            setTimeout(() => {
                successAlert.classList.remove('hidden');
                successAlert.classList.add('flex');
                
                showCustomModal('Berhasil Disusun', 'Pesan Anda telah berhasil diformat tanpa batas limit API! Anda akan segera diarahkan ke WhatsApp resmi Alpha Finance Consulting.', true);

                // Use try-catch fallback for popup blockers or strict environment restrictions
                try {
                    const newWindow = window.open(whatsappURL, '_blank');
                    if (!newWindow || newWindow.closed || typeof newWindow.closed == 'undefined') {
                        // Fallback if popup blocker triggers
                        window.location.href = whatsappURL;
                    }
                } catch (err) {
                    window.location.href = whatsappURL;
                }

                document.getElementById('contactForm').reset();
                btn.innerHTML = originalText;
                btn.disabled = false;
                btn.classList.remove('opacity-70');
                
                setTimeout(() => {
                    successAlert.classList.add('hidden');
                    successAlert.classList.remove('flex');
                }, 6000);
            }, 600);
        }
    </script>
