    <style>
        body { font-family: 'Inter', sans-serif; overflow-x: hidden; }
        
        .dark-nav {
            background: rgba(7, 26, 45, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
